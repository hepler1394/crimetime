    },
    {
      "source": "/api/handle",
      "destination": "https://crimetime-community.vercel.app/api/handle"
    },
    {
      "source": "/api/account",
      "destination": "https://crimetime-community.vercel.app/api/account"
    },
    {
      "source": "/api/account/:path*",
      "destination": "https://crimetime-community.vercel.app/api/account/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://crimetime-community.vercel.app/auth/:path*"
    },
    {
      "source": "/_community/:path*",
      "destination": "https://crimetime-community.vercel.app/_community/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "crimetime.vercel.app"
        }
      ],
      "destination": "https://www.crimetimesnacks.com/$1",
      "permanent": true
    },
