# .gitignore for CrimeTimeSnacks website

# Environment variables
.env

# Node modules if using build tools
node_modules/

# Build directories
dist/
build/

# Editor directories and files
.idea/
.vscode/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Secrets / API keys — NEVER commit these ---
.env
.env.*
automation/config.json
automation/secrets.json
**/secrets.json
*.local.json
secrets/

# cron logs
automation/cron/cron.log

# podcast studio working files (drafts hold MP3/MP4 renders; published copies live in /audio and /images/episodes)
automation/studio/drafts/
automation/cron/cron.log.old
automation/studio/.venv/
automation/studio/models/
automation/studio/research/

.vercel
.env*
automation/.env.community
studio-shell/node_modules/
studio-shell/profile/

# Instagram post renders regenerate from post.json (node automation/social-post.mjs <id>)
automation/studio/posts/*/slide-*.jpg
automation/studio/posts/*/bg-*.png
automation/studio/posts/*/*.mp4

# case footage: the clips are downloaded, not authored. sources.json records the
# URL, the in and out points and the rights basis, so any clip can be cut again
# with one command - there is no reason to carry 5 MB of press conference per cut.
automation/studio/footage/*/clips/
automation/studio/footage/*/sources/*.vtt
automation/studio/footage/*/.work/

# Studio: personal and licensed assets never ship. Four scripts run `git add -A`
# in this tree, so this list is the guard. Research projects (PDFs, clippings,
# chat.json), the voice-clone reference and takes, Cory's own theme tracks and
# the beds rendered from them, and anything downloaded in the shell's browser.
automation/studio/projects/
automation/studio/voice/
automation/studio/music/
studio-shell/downloads/

# Written by the desktop shell: which Instagram profile its browser session is active as.
automation/studio/ig-account.json
automation/studio/ig-switch.json
automation/studio/ig-known-profiles.json
automation/studio/ig-post.json

# Re-enactment renders regenerate from script.json (node automation/reenact.mjs <slug>).
# The script is the editorial record and stays in git; the audio and the
# per-line Deepgram cache do not.
automation/studio/reenact/*/*.mp3
automation/studio/reenact/*/.cache/
automation/studio/reenact/*/.work/

# Atomic provider settings writes
automation/config.json.*.tmp
automation/studio/jobs/
automation/studio/releases/

# Claude Code local permissions (personal, not team-wide)
.claude/settings.local.json
