# .gitignore for CrimeTimeSnacks website

# Environment variables
.env

# Node modules if using build tools
node_modules/

# Build directories
dist/
build/

# Editor directories and files
.idea/
.vscode/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Secrets / API keys — NEVER commit these ---
.env
.env.*
automation/config.json
automation/secrets.json
**/secrets.json
*.local.json
secrets/

# cron logs
automation/cron/cron.log

# podcast studio working files (drafts hold MP3/MP4 renders; published copies live in /audio and /images/episodes)
automation/studio/drafts/
automation/cron/cron.log.old
automation/studio/.venv/
automation/studio/models/
automation/studio/research/

.vercel
.env*
automation/.env.community
studio-shell/node_modules/
studio-shell/profile/

# Instagram post renders regenerate from post.json (node automation/social-post.mjs <id>)
automation/studio/posts/*/slide-*.jpg
automation/studio/posts/*/bg-*.png
automation/studio/posts/*/*.mp4

# Studio: personal and licensed assets never ship. Four scripts run `git add -A`
# in this tree, so this list is the guard. Research projects (PDFs, clippings,
# chat.json), the voice-clone reference and takes, Cory's own theme tracks and
# the beds rendered from them, and anything downloaded in the shell's browser.
automation/studio/projects/
automation/studio/voice/
automation/studio/music/
studio-shell/downloads/
